{
  "name": "@updf/core",
  "version": "2.0.0-poc.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./resources": {
      "types": "./dist/resources.d.ts",
      "import": "./dist/resources.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pdf": {
      "types": "./dist/pdf.d.ts",
      "import": "./dist/pdf.js"
    },
    "./painting": {
      "types": "./dist/painting/index.d.ts",
      "import": "./dist/painting/index.js"
    },
    "./vdom": {
      "types": "./dist/vdom/index.d.ts",
      "import": "./dist/vdom/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    },
    "./internal-drawing": {
      "types": "./dist/internal-drawing.d.ts",
      "import": "./dist/internal-drawing.js"
    }
  },
  "dependencies": {
    "@updf/layout-kernel": "2.0.0-poc.0"
  },
  "scripts": {
    "build": "node --input-type=module -e \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\" && tsc -p tsconfig.json"
  }
}
