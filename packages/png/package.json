{
  "name": "@updf/png",
  "version": "2.0.0-poc.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    "./alpha": {
      "browser": {
        "types": "./dist/node/alpha.d.mts",
        "default": "./dist/alpha.js"
      },
      "import": {
        "types": "./dist/node/alpha.d.mts",
        "default": "./dist/node/alpha.mjs"
      },
      "require": {
        "types": "./dist/node/alpha.d.cts",
        "default": "./dist/cjs/alpha.js"
      }
    },
    "./normalization": {
      "browser": {
        "types": "./dist/node/normalization.d.mts",
        "default": "./dist/normalization.js"
      },
      "import": {
        "types": "./dist/node/normalization.d.mts",
        "default": "./dist/node/normalization.mjs"
      },
      "require": {
        "types": "./dist/node/normalization.d.cts",
        "default": "./dist/cjs/normalization.js"
      }
    },
    ".": {
      "browser": {
        "types": "./dist/node/index.d.mts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/node/index.d.mts",
        "default": "./dist/node/index.mjs"
      },
      "require": {
        "types": "./dist/node/index.d.cts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "dependencies": {
    "@updf/core": "2.0.0-poc.0"
  },
  "scripts": {
    "build": "tsx ../../scripts/packaging/build.ts"
  }
}
