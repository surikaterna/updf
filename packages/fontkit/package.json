{
  "name": "@updf/fontkit",
  "version": "2.0.0-poc.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./load": {
      "browser": {
        "types": "./dist/node/load.d.mts",
        "default": "./dist/load.js"
      },
      "import": {
        "types": "./dist/node/load.d.mts",
        "default": "./dist/node/load.mjs"
      },
      "require": {
        "types": "./dist/node/load.d.cts",
        "default": "./dist/cjs/load.js"
      }
    },
    ".": {
      "browser": {
        "types": "./dist/node/index.d.mts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/node/index.d.mts",
        "default": "./dist/node/index.mjs"
      },
      "require": {
        "types": "./dist/node/index.d.cts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "dependencies": {
    "@updf/assets": "2.0.0-poc.0",
    "@updf/fonts": "2.0.0-poc.0",
    "@updf/core": "2.0.0-poc.0"
  },
  "peerDependencies": {
    "fontkit": "^2.0.4"
  },
  "peerDependenciesMeta": {
    "fontkit": {
      "optional": true
    }
  },
  "devDependencies": {
    "fontkit": "2.0.4"
  },
  "scripts": {
    "build": "tsx ../../scripts/packaging/build.ts"
  }
}
