{
  "name": "@updf/text-flow",
  "version": "2.0.0-poc.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./path": {
      "browser": {
        "types": "./dist/node/path-entry.d.mts",
        "default": "./dist/path-entry.js"
      },
      "import": {
        "types": "./dist/node/path-entry.d.mts",
        "default": "./dist/node/path-entry.mjs"
      },
      "require": {
        "types": "./dist/node/path-entry.d.cts",
        "default": "./dist/cjs/path-entry.js"
      }
    },
    "./atomic": {
      "browser": {
        "types": "./dist/node/atomic.d.mts",
        "default": "./dist/atomic.js"
      },
      "import": {
        "types": "./dist/node/atomic.d.mts",
        "default": "./dist/node/atomic.mjs"
      },
      "require": {
        "types": "./dist/node/atomic.d.cts",
        "default": "./dist/cjs/atomic.js"
      }
    },
    ".": {
      "browser": {
        "types": "./dist/node/index.d.mts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/node/index.d.mts",
        "default": "./dist/node/index.mjs"
      },
      "require": {
        "types": "./dist/node/index.d.cts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "dependencies": {
    "@updf/geometry": "2.0.0-poc.0",
    "@updf/core": "2.0.0-poc.0",
    "@updf/layout": "2.0.0-poc.0",
    "@updf/text": "2.0.0-poc.0",
    "@updf/layout-boxes": "2.0.0-poc.0"
  },
  "scripts": {
    "build": "tsx ../../scripts/packaging/build.ts"
  }
}
