{
  "$schema": "https://biomejs.dev/schemas/2.4.13/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "packages/core/**",
      "packages/layout/**",
      "packages/layout-kernel/**",
      "packages/tables/**",
      "packages/geometry/**",
      "packages/svg/**",
      "packages/fontkit/**",
      "packages/fonts/**",
      "packages/text/**",
      "packages/jpeg/**",
      "apps/**",
      "examples/**",
      "scripts/**",
      "tests/**",
      "package.json",
      "tsconfig*.json",
      "biome.json",
      "!**/dist",
      "!**/dist-*",
      "!**/build",
      "!**/out",
      "!**/artifacts",
      "!**/node_modules",
      "!**/archive",
      "!**/snapshots",
      "!**/__snapshots__",
      "!**/generated-reports",
      "!**/package-lock.json",
      "!tests/fixtures/fonts/liberation-sans.json",
      "!tests/fixtures/fonts/*.ttf"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120, "lineEnding": "lf" },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noDefaultExport": "error",
        "noCommonJs": "error",
        "noNamespace": "error",
        "useConst": "error",
        "useArrayLiterals": "error",
        "useAsConstAssertion": "error",
        "useImportType": "error",
        "noNonNullAssertion": "warn"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noArrayIndexKey": "warn",
        "noEmptyInterface": "error",
        "noExtraNonNullAssertion": "error",
        "noMisleadingInstantiator": "error",
        "noNonNullAssertedOptionalChain": "error",
        "noTsIgnore": "error",
        "noUnsafeDeclarationMerging": "error",
        "noUnusedExpressions": "error",
        "useNamespaceKeyword": "error"
      },
      "nursery": { "noDuplicateEnumValues": "error" },
      "complexity": {
        "noExcessiveCognitiveComplexity": { "level": "warn", "options": { "maxAllowedComplexity": 15 } },
        "noForEach": "warn",
        "noBannedTypes": "error",
        "noUselessThisAlias": "error",
        "noUselessTypeConstraint": "error",
        "useLiteralKeys": "off"
      },
      "correctness": { "noUnusedImports": "error", "noUnusedVariables": "error" }
    }
  },
  "overrides": [
    {
      "includes": ["packages/core/src/jsx-runtime.ts"],
      "linter": { "rules": { "style": { "noNamespace": "off" } } }
    },
    {
      "includes": [
        "apps/browser-react/vite.config.ts",
        "apps/browser-react/vite.core.config.ts",
        "apps/browser-react/vite.vdom.config.ts",
        "apps/browser-react/vite.fonts.config.ts",
        "apps/browser-react/vite.measurement.config.ts",
        "apps/browser-react/vite.flow.config.ts",
        "apps/browser-react/vite.tables.config.ts",
        "apps/browser-react/vite.composable-tables.config.ts",
        "apps/browser-react/vite.geometry.config.ts",
        "apps/browser-react/vite.svg.config.ts",
        "apps/browser-react/vite.fontkit.config.ts",
        "apps/browser-fonts/vite.config.ts",
        "apps/showcase/vite.config.ts"
      ],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    }
  ]
}
