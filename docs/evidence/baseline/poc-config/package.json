{
  "name": "@updf/declarative-poc",
  "version": "2.0.0-poc.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cmr": {
      "types": "./dist/examples/cmr.d.ts",
      "import": "./dist/examples/cmr.js"
    },
    "./cmr-tree": {
      "types": "./dist/examples/cmr-tree.d.ts",
      "import": "./dist/examples/cmr-tree.js"
    },
    "./vdom": {
      "types": "./dist/vdom/index.d.ts",
      "import": "./dist/vdom/index.js"
    },
    "./fonts": {
      "types": "./dist/fonts/index.d.ts",
      "import": "./dist/fonts/index.js"
    },
    "./fontkit": {
      "types": "./dist/fontkit/index.d.ts",
      "import": "./dist/fontkit/index.js"
    },
    "./painting": {
      "types": "./dist/painting/index.d.ts",
      "import": "./dist/painting/index.js"
    },
    "./geometry": {
      "types": "./dist/geometry/index.d.ts",
      "import": "./dist/geometry/index.js"
    },
    "./svg": {
      "types": "./dist/svg/index.d.ts",
      "import": "./dist/svg/index.js"
    },
    "./svg-tree": {
      "types": "./dist/svg/tree.d.ts",
      "import": "./dist/svg/tree.js"
    },
    "./cmr-unicode": {
      "types": "./dist/examples/cmr-unicode.d.ts",
      "import": "./dist/examples/cmr-unicode.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "build:browser": "vite build --config fixtures/vite-react/vite.config.ts",
    "build:core": "vite build --config fixtures/vite-react/vite.core.config.ts",
    "build:vdom": "vite build --config fixtures/vite-react/vite.vdom.config.ts",
    "build:geometry": "vite build --config fixtures/vite-react/vite.geometry.config.ts",
    "build:svg": "vite build --config fixtures/vite-react/vite.svg.config.ts",
    "test:svg-browser": "tsx --test fixtures/svg-reference/browser.test.ts",
    "build:fonts": "vite build --config fixtures/vite-react/vite.fonts.config.ts",
    "build:fontkit": "vite build --config fixtures/vite-react/vite.fontkit.config.ts",
    "build:font-browser": "vite build --config fixtures/font-browser/vite.config.ts",
    "lint": "eslint .",
    "test": "tsx --test test/*.test.ts",
    "test:browser": "tsx --test fixtures/vite-react/browser.test.ts",
    "test:font-browser": "tsx --test fixtures/font-browser/browser.test.ts",
    "test:consumer": "tsx tools/packed-consumer.ts",
    "check:graphs": "tsx tools/graph-check.ts",
    "sizes": "tsx tools/sizes.ts"
  },
  "files": [
    "dist",
    "README.md",
    "geometry/LICENSE.svgpath",
    "geometry/REUSE.md",
    "svg/REUSE.md"
  ],
  "peerDependencies": {
    "fontkit": "^2.0.4"
  },
  "peerDependenciesMeta": {
    "fontkit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "fontkit": "2.0.4",
    "jiti": "2.7.0",
    "playwright": "1.55.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6"
  }
}
