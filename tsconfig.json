{
  "include": ["src"],
  "exclude": ["node_modules", "**/*.spec.[jt]s"],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./lib",
    "module": "esnext",
    "lib": [
      "esnext"
    ],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "allowJs": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "types": ["node", "jest"],
    "skipLibCheck": true
  }
}
