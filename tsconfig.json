{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "types": ["node", "react", "react-dom"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "packages/*/test/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "scripts/**/*.ts",
    "examples/**/*.ts",
    "examples/**/*.tsx",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "eslint.config.ts"
  ],
  "exclude": ["**/node_modules", "**/dist", "**/dist-*", "packages/legacy", "docs", "artifacts"]
}
