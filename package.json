{
  "name": "@surikat/updf",
  "version": "0.4.13",
  "description": "Hopefully tiny and modular library to generate PDF's in JS",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "compile": "rimraf lib && run-p compile:*",
    "compile:types": "tsc",
    "compile:js": "node scripts/build.mjs",
    "dev": "rimraf lib && run-p dev:*",
    "dev:types": "tsc --watch",
    "dev:js": "node scripts/dev.mjs",
    "format": "prettier --write src test",
    "prepare": "npm run compile"
  },
  "devDependencies": {
    "@es-exec/esbuild-plugin-start": "^0.0.5",
    "@types/jest": "^29.5.1",
    "@types/node": "^20.1.4",
    "es-jest": "^2.1.0",
    "esbuild": "^0.17.19",
    "jest": "^29.5.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.8",
    "prettier-config-surikaterna": "^1.0.1",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.4"
  },
  "keywords": [
    "PDF",
    "JS"
  ],
  "author": "Surikat AB",
  "license": "MIT"
}
